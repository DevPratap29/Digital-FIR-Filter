`timescale 1ns/1ps
// Simple directed testbench for FIR.sv (plain SystemVerilog, no UVM). Each test prints PASS or FAIL.
module tb_FIR;
    logic CLK = 0, RSTn = 0, FIREN = 0, CENWR = 0, COMMIT = 0;
    logic signed [11:0] x_in = 0;
    logic [3:0]  CADDR = 0;
    logic [31:0] CDATA = 0;
    logic signed [31:0] y_out;
    logic BUSY, DONE;
    logic [15:0] SREADY;

    FIR dut(.CLK(CLK), .RSTn(RSTn), .FIREN(FIREN), .x_in(x_in), .y_out(y_out), .BUSY(BUSY),
            .CENWR(CENWR), .CADDR(CADDR), .CDATA(CDATA), .SREADY(SREADY), .COMMIT(COMMIT), .DONE(DONE));

    always #5 CLK = ~CLK;

    // test coefficients: negatives and both 16-bit extremes
    logic signed [15:0] H [0:15];
    initial begin
        H[0]=-32768; H[1]=32767; H[2]=-1;   H[3]=1;    H[4]=1000;  H[5]=-1000; H[6]=12345; H[7]=-12345;
        H[8]=0;      H[9]=2;     H[10]=-2;  H[11]=300; H[12]=-300; H[13]=7;    H[14]=-7;   H[15]=32767;
    end

    int errors = 0;

    // wait for the next rising edge plus 1 ns: outputs have updated, new inputs go in for the next edge
    task automatic tick();
        @(posedge CLK); #1;
    endtask

    task automatic check(input string what, input logic signed [63:0] got, input logic signed [63:0] expected);
        if (got !== expected) begin
            errors++;
            $display("    FAIL: %s = %0d, expected %0d", what, got, expected);
        end
    endtask

    task automatic report(input string test, input int errors_before);
        $display("%s  %s", (errors == errors_before) ? "PASS" : "FAIL", test);
    endtask

    // one CPU write: the 16-bit value padded into the 32-bit CDATA word, top half = sign copies or garbage
    task automatic write_coef(input int addr, input logic signed [15:0] value, input bit garbage_top);
        CENWR = 1; CADDR = addr[3:0];
        CDATA = garbage_top ? {16'hA5A5, value} : {{16{value[15]}}, value};
        tick();
        CENWR = 0;
    endtask

    // write the same value to all 16 taps, commit, wait for DONE
    task automatic load_all(input logic signed [15:0] value);
        int t;
        for (int k = 0; k < 16; k++) write_coef(k, value, 0);
        COMMIT = 1; tick(); COMMIT = 0;
        t = 0;
        while (!DONE && t < 10) begin tick(); t++; end
    endtask

    int e, sumH;
    logic signed [31:0] held;

    initial begin
        // T1: reset
        repeat (3) tick();
        e = errors;
        check("y_out", y_out, 0);  check("SREADY", SREADY, 0);  check("DONE", DONE, 0);  check("BUSY", BUSY, 0);
        report("T1  reset clears everything", e);
        RSTn = 1;  FIREN = 1;

        // T2: write taps 0..7 (half of them with garbage in CDATA[31:16]); SREADY fills up bit by bit
        e = errors;
        for (int k = 0; k < 8; k++) begin
            write_coef(k, H[k], k % 2);
            check("SREADY", SREADY, (1 << (k + 1)) - 1);
        end
        report("T2  coefficient writes set SREADY bit by bit", e);

        // T3: COMMIT before all writes are done: DONE waits for the last write, then lasts exactly 1 clock
        e = errors;
        COMMIT = 1;  tick();  COMMIT = 0;
        for (int k = 8; k < 16; k++) begin
            check("DONE (too early)", DONE, 0);
            write_coef(k, H[k], k % 2);
        end
        check("DONE (too early)", DONE, 0);
        check("SREADY before swap", SREADY, 16'hFFFF);
        tick();  check("DONE", DONE, 1);  check("SREADY after commit", SREADY, 0);
        tick();  check("DONE (1 clock only)", DONE, 0);
        report("T3  COMMIT waits for all writes, DONE is a 1-clock pulse", e);

        // T4: impulse x = 1 -> y_out shows h[0], h[1] ... h[15], then 0 (every tap holds the right signed value)
        e = errors;
        x_in = 1;  tick();  x_in = 0;
        check("y_out", y_out, H[0]);
        for (int k = 1; k < 16; k++) begin tick(); check("y_out", y_out, H[k]); end
        tick();  check("y_out after impulse", y_out, 0);
        report("T4  impulse response = the 16 coefficients, signs intact", e);

        // T5: full-scale negative impulse x = -2048 -> y_out = -2048 * h[k] (signed multiply)
        e = errors;
        x_in = -2048;  tick();  x_in = 0;
        check("y_out", y_out, -2048 * H[0]);
        for (int k = 1; k < 16; k++) begin tick(); check("y_out", y_out, -2048 * H[k]); end
        tick();
        report("T5  negative full-scale impulse", e);

        // T6: step x = 100 -> after 16 clocks y_out = 100 * (sum of all 16 coefficients)
        e = errors;
        sumH = 0;
        for (int k = 0; k < 16; k++) sumH += H[k];
        x_in = 100;  repeat (16) tick();
        check("y_out", y_out, 100 * sumH);
        x_in = 0;  repeat (16) tick();
        report("T6  step response = 100 x sum of coefficients", e);

        // T7: worst case, no overflow: all h = -32768 and x = -2048 -> 16 x 2^26 = 2^30, then all h = 32767
        e = errors;
        load_all(-32768);
        x_in = -2048;  repeat (16) tick();
        check("y_out", y_out, 64'sd1073741824);
        load_all(32767);
        repeat (16) tick();
        check("y_out", y_out, -64'sd1073709056);
        x_in = 0;
        report("T7  worst case fits 32 bits: +1,073,741,824 and -1,073,709,056", e);

        // T8: FIREN low: output holds, BUSY drops, writes and COMMIT are ignored
        e = errors;
        x_in = 5;  repeat (3) tick();
        FIREN = 0;  held = y_out;
        CENWR = 1;  CADDR = 0;  CDATA = 32'h0000_1234;  COMMIT = 1;
        repeat (3) tick();
        check("y_out (held)", y_out, held);  check("BUSY", BUSY, 0);  check("SREADY", SREADY, 0);  check("DONE", DONE, 0);
        CENWR = 0;  COMMIT = 0;  FIREN = 1;  tick();
        check("BUSY", BUSY, 1);
        for (int k = 0; k < 16; k++) write_coef(k, 1, 0);       // all taps written, but the COMMIT above was ignored...
        repeat (3) begin tick(); check("DONE (COMMIT was ignored)", DONE, 0); end   // ...so no DONE
        report("T8  FIREN low freezes the filter and ignores the CPU", e);

        // T9: reset wins over FIREN: control clears at once, the math clears at the next edge, coefficients go to 0
        e = errors;
        x_in = 300;  repeat (3) tick();                          // filter running, FIREN = 1
        if (y_out == 0) begin errors++; $display("    FAIL: y_out should be non-zero before reset"); end
        RSTn = 0;  #1;
        check("SREADY (at once)", SREADY, 0);  check("BUSY (at once)", BUSY, 0);
        tick();
        check("y_out (next edge)", y_out, 0);
        RSTn = 1;  repeat (5) tick();
        check("y_out (coefficients are 0 after reset)", y_out, 0);
        report("T9  RSTn has priority over FIREN", e);

        if (errors == 0) $display("\nALL TESTS PASSED");
        else             $display("\n%0d CHECK(S) FAILED", errors);
        $finish;
    end
endmodule
